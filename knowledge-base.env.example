# Required secrets. Replace both values before deployment.
API_SERVER_KEY=replace-with-at-least-16-random-characters
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-strong-password

# Image loaded from the release archive.
HERMES_WORKSPACE_IMAGE=ds-hermes-workspace:20260822-chatfix

# Host persistence. The repository directory may contain multiple wikis.
HERMES_DATA_DIR=/opt/ds-hermes/data/hermes
KNOWLEDGE_REPOSITORY_DIR=/opt/ds-hermes/data/knowledge_repository

# Optional host ports and container user mapping.
PORT=6060
PREVIEW_FRONTEND_PORT=8651
# Host-side web port. Keep the container-side port 4178 unchanged.
KNOWLEDGE_BASE_HOST_IP=127.0.0.1
KNOWLEDGE_BASE_HOST_PORT=4178
HERMES_UID=10000
HERMES_GID=10000
