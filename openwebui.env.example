HERMES_IMAGE=ds-hermes-agent:20260914
OPEN_WEBUI_IMAGE=ds-open-webui:20260914
OPEN_WEBUI_SOURCE_DIR=../open-webui
OPEN_WEBUI_BUILD_HASH=local-20260914
OPEN_WEBUI_NPM_REGISTRY=https://registry.npmmirror.com
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PORT=3000
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_PORT=6060
HERMES_UID=10000
HERMES_GID=10000
HERMES_DATA_DIR=/opt/ds-hermes/data/hermes
HERMES_WORKSPACE_DIR=/opt/ds-hermes/data/hermes/workspace
# Generate two different values with: openssl rand -hex 32
API_SERVER_KEY=
WEBUI_SECRET_KEY=
WEBUI_EMBED_ALLOWED_ORIGINS=http://localhost:8088
WEBUI_EMBED_AUTO_CREATE=true
